#define TEST_VECTOR_COUNT (sizeof(vectors) / sizeof(vectors[0]))

static TestVector currentVector;
static uint8_t encryptOutput[MAX_PLAINTEXT + 16];
static uint8_t decryptOutput[MAX_PLAINTEXT];

static bool runVector(const TestVector *vector)
{
  size_t ciphertextLength = 0, messageLength = 0;

  // (1) Cifra e compara com o (ciphertext || tag) esperado.
  ascon128a_aead_encrypt(encryptOutput, &ciphertextLength,
                         vector->plaintext, vector->plaintextLength,
                         vector->associatedData, vector->associatedDataLength,
                         vector->nonce, vector->key);

  if (ciphertextLength != vector->expectedCiphertextLength ||
      memcmp(encryptOutput, vector->expectedCiphertext, vector->expectedCiphertextLength) != 0)
  {
    return false;
  }

  // (2) Decifra o valor esperado e confirma texto claro + tag valida.
  int decryptResult = ascon128a_aead_decrypt(decryptOutput, &messageLength,
                                             vector->expectedCiphertext, vector->expectedCiphertextLength,
                                             vector->associatedData, vector->associatedDataLength,
                                             vector->nonce, vector->key);
                                             
  if (decryptResult < 0 || messageLength != vector->plaintextLength)
  {
    return false;
  }

  if (vector->plaintextLength &&
      memcmp(decryptOutput, vector->plaintext, vector->plaintextLength) != 0)
  {
    return false;
  }

  return true;
}

void setup()
{
  Serial.begin(115200);
  delay(300);

  Serial.println();
  Serial.println("=== Ascon-128a KAT (on-device, ESP32) ===");
  Serial.print("Estado incremental (bytes): ");
  Serial.println((unsigned) sizeof(ascon128a_state_t));
  Serial.println();

  int passedCount = 0;
  for (size_t vectorIndex = 0; vectorIndex < TEST_VECTOR_COUNT; vectorIndex++) {
    memcpy_P(&currentVector, &vectors[vectorIndex], sizeof(TestVector));

    Serial.print(currentVector.name);
    Serial.print(" ... ");

    if (runVector(&currentVector)) {
      Serial.println("OK");
      passedCount++;
    }
    else {
      Serial.println("FALHOU");
    }
  }

  Serial.println();
  Serial.print("Resultado: ");
  Serial.print(passedCount);
  Serial.print("/");
  Serial.print((int) TEST_VECTOR_COUNT);
  Serial.println(" vetores passaram.");

  if (passedCount == (int) TEST_VECTOR_COUNT) {
    Serial.println(">>> TODOS OS VETORES PASSARAM NA PLACA <<<");
  }
  else {
    Serial.println(">>> FALHA: divergencia na placa <<<");
  }
}

void loop()
{
  // O teste roda uma vez no setup(). Um loop() vazio fica em "busy-spin" no
  // ESP32: satura um nucleo da CPU e impede a tarefa ociosa de rodar, o que
  // dispara o watchdog, que inunda a Serial e trava o Monitor Serial.
  // O delay() cede o processador e elimina esse comportamento.
  delay(1000);
}
